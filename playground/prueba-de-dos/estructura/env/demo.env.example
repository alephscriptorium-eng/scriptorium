# ============================================================================
# Env de la demo · prueba-de-dos (WP-G52) — FICHERO DE EJEMPLO, todo comentado
# Uso: copiar a la ventana generada (H/.env o M/.env) y descomentar lo que
# aplique. Este fichero NO se carga solo: documenta el contrato.
#
# REGLA (estructura antes que UI): si una variable apunta a un directorio,
# ese directorio vive DENTRO del playground (root propio de la ventana).
# Jamás apunta a un pack instalado (node_modules) ni a otro checkout/repo.
# Los packs se obtienen por su contrato (nombre+versión+canal): ver
# ../packs/*.md — no por ruta de disco.
# ============================================================================

# --- Room compartida ---------------------------------------------------------
# Ambas ventanas (H y M) entran a la MISMA room del nodo rooms.
# Lee: player-mcp (peer-card / room-bridge) y fixtures de federación del juego.
ZEUS_CIUDAD_ROOM=CIUDAD_DEMO

# --- Identidad de la ventana -------------------------------------------------
# Actor del jugador en la room (uno por ventana; default del engine: rabbit).
# ZEUS_CIUDAD_PLAYER_ACTOR=visitante

# Usuario ante el scriptorium (peercard — vías legales en ../../reference/PEERCARD.md).
# ZEUS_SCRIPTORIUM_USER=

# --- Endpoints ---------------------------------------------------------------
# Puerto del MCP de ciudad de ESTA ventana (default 4133; uno distinto por ventana).
# ZEUS_MCP_CIUDAD=4141

# Nodo rooms externo: descomentar y apuntar si no se levanta en local (handoff-H).
# ZEUS_SCRIPTORIUM_URL=http://localhost:3017

# --- Cadencia de la autoridad (defaults del engine si no se fijan) -----------
# CIUDAD_TICK_MS=200
# CIUDAD_STATE_HEARTBEAT_MS=5000

# --- Startpack ---------------------------------------------------------------
# Por DEFECTO el startpack se resuelve como paquete npm instalado en la ventana
# (@zeus/startpack-ciudad, contrato en ../packs/startpack-ciudad.md): sin env.
# Override OPCIONAL: root propio del playground con el árbol del pack
# descomprimido POR EL OPERADOR bajo su ventana (p. ej. H/startpack-root/,
# ignorado por git como H/ entera). Nunca un pack de node_modules, nunca otro repo.
# ZEUS_STARTPACK_CIUDAD=./startpack-root
# ZEUS_STARTPACK_ROOT=./startpack-root

# Falla dura si no hay startpack resoluble (opt-in del operador):
# ZEUS_STARTPACK_REQUIRED=1

# ============================================================================
# Evidencia de cada variable (repo G Z_SDK-games-library, commit daef20b):
#   ZEUS_CIUDAD_ROOM            packages/ciudad/src/player-mcp/peer-card.mjs:89
#                               packages/ciudad/src/player-mcp/room-bridge.mjs:79
#   ZEUS_CIUDAD_PLAYER_ACTOR    packages/ciudad/src/player-mcp/config.mjs:24
#                               packages/ciudad/src/player-mcp/start.mjs:3
#   ZEUS_SCRIPTORIUM_USER       packages/ciudad/src/authority.mjs:27
#   ZEUS_MCP_CIUDAD             packages/ciudad/src/endpoints.mjs:19 (default 4133)
#   ZEUS_SCRIPTORIUM_URL        packages/ciudad/src/player-mcp/peer-card.mjs:92
#   CIUDAD_TICK_MS              packages/ciudad/src/authority.mjs:29
#   CIUDAD_STATE_HEARTBEAT_MS   packages/ciudad/src/authority.mjs:30
#   ZEUS_STARTPACK_CIUDAD/ROOT  packages/ciudad/src/startpack.mjs:18
#   ZEUS_STARTPACK_REQUIRED     packages/ciudad/src/startpack.mjs:26
#   (autoridad exige startpack)  packages/ciudad/src/authority.mjs:18 (Z02)
# Valores de arranque tomados de las ventanas vivas del playground ciudad:
#   playground/ciudad/autoridad/.env · playground/ciudad/visitante/.env
# ============================================================================
