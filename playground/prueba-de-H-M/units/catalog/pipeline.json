    { "name": "vector-mock", "mediaType": "application/json" }
  ],
  "outputs": [
    { "name": "linea-onfalo", "mediaType": "application/json" },
    { "name": "linea-futuros", "mediaType": "application/json" }
  ],
  "dependencies": ["bartleby", "vector-mock", "cristalizador"],
