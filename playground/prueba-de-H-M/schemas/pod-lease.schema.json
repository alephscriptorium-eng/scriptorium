{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriptorium.local/hm/schemas/pod-lease.schema.json",
  "title": "HmPodLease",
  "description": "Lease bilateral H→M para inflación de unidad",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leaseId",
    "emitterIri",
    "receiverIri",
    "unitId",
    "permissions",
    "issuedAt",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "leaseId": { "type": "string" },
    "emitterIri": { "type": "string" },
    "receiverIri": { "type": "string" },
    "unitId": { "type": "string" },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string" },
        "value": { "type": "string", "minLength": 8 }
      }
    }
  }
}
